{
  // Cloudflare Worker: kuulutus.konderi.fi
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuulutus",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Kaikki pyynnöt kulkevat Workerin kautta (salasanasuojaus), joka tarjoilee käyttöliittymän (static/)
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "kuulutus.konderi.fi", "custom_domain": true }
  ],
  "vars": {
    "AZURE_SPEECH_REGION": "swedencentral"
  },
  // Salaisuudet (ei tähän tiedostoon): Cloudflare-hallinnasta
  // Workers & Pages → kuulutus → Settings → Variables and Secrets
  //   AZURE_SPEECH_KEY   (pakollinen puheäänelle)
  //   ANTHROPIC_API_KEY  (valinnainen, pöytäkirjan kuvan lukeminen)
  //   SITE_PASSWORD      (sivuston salasana; asetetaan GitHub-salaisuudesta julkaisun yhteydessä)
  "observability": { "enabled": true }
}
